{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GhostChat",
  "version": "4.0.8",
  "identifier": "app.ghostchat.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GhostChat",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost http://127.0.0.1:* https: ws: wss:; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": ["icons/ghostchat.ico"],
    "targets": ["msi", "nsis"],
    "category": "SocialNetworking",
    "shortDescription": "Lightweight anonymous chat",
    "longDescription": "A lightweight anonymous chat client with a self-hostable server.",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ghostchat"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxMjY3RDk0QkQyMjNFMDAKUldRQVBpSzlsSDBtOGI5V3VCOFNTd1J6c1NuSU9PRUJVaFM4bVFXWC9IK29GQktXQmFUR05RQTEK",
      "endpoints": ["https://github.com/crsh6663r4234/getchat/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

