# Copy to your server environment and change only the values you need.
# The Rust API should normally stay on loopback behind an HTTPS reverse proxy.
GHOSTCHAT_BIND=127.0.0.1:38241
GHOSTCHAT_DATABASE=/var/lib/ghostchat/ghostchat.sqlite
# Comma-separated ICE servers used by one-to-one WebRTC calls.
GHOSTCHAT_STUN_URLS=stun:stun.l.google.com:19302
# Optional coturn URLs. Enable time-limited TURN credentials with the shared secret below.
# Example: turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
GHOSTCHAT_TURN_URLS=
# Keep private; use the same value as coturn's static-auth-secret.
GHOSTCHAT_TURN_SHARED_SECRET=
